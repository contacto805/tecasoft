{
  "cli": {
    "version": ">= 10.16.0"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      }
    },
    "preview2": {
      "android": {
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "preview3": {
      "developmentClient": true
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildType": "app"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccount": "~/.secrets/play-store-key.json",
        "track": "internal"
      }
    }
  }
}
